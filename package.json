{
  "name": "@yyfather/dsh-billing-dock",
  "version": "1.0.2",
  "description": "Floating billing dock for DSH: today cost, peak/off-peak rate and countdown, host light/dark aware. Standalone usage parser.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "usage.js",
    "client.js",
    "dock.css",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "billing",
    "usage",
    "cost",
    "fairy"
  ],
  "license": "MIT",
  "author": "YYfather",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYfather/dsh-billing-dock.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
